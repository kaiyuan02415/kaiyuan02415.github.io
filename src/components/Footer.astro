---
import { SITE } from "../consts";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide foot-inner">
    <span>© {year} {SITE.author}</span>
    <span class="dot">·</span>
    <span>Built with Astro</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    color: var(--fg-subtle);
    font-size: 0.82rem;
  }
  .foot-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    opacity: 0.6;
  }
</style>
