---
interface Props {
  text: string;
  attribution?: string;
}
const { text, attribution } = Astro.props;
---

<aside class="page-quote">
  <p class="page-quote-text">&ldquo;{text}&rdquo;</p>
  {attribution && <p class="page-quote-attr">{attribution}</p>}
</aside>

<style>
  .page-quote {
    margin-top: 3.5rem;
    padding: 1.6rem 1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .page-quote-text {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    letter-spacing: 0.005em;
  }
  .page-quote-attr {
    margin: 0.6rem 0 0;
    font-family: var(--font-sans);
    font-style: normal;
    color: var(--fg-subtle);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
