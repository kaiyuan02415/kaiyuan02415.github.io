---
import { SOCIALS } from "../consts";
import SocialIcon from "./SocialIcon.astro";
---

<aside class="profile">
  <div class="avatar-wrap">
    <img src="/Avatar.jpg" alt="Kaiyuan Deng" class="avatar" />
  </div>
  <div class="info">
    <h1 class="name">Kaiyuan Deng</h1>
    <p class="zh">邓凯元</p>
    <p class="affiliation">
      Ph.D. student<br />
      <a class="link" href="https://ece.engineering.arizona.edu/">
        University of Arizona</a
      >
    </p>
    <p class="address subtle">Tucson, AZ · USA</p>

    <ul class="socials" aria-label="Social links">
      {
        SOCIALS.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.name}
              title={s.name}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={
                s.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
            >
              <SocialIcon name={s.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 0 0;
    position: sticky;
    top: 5.5rem;
  }

  .avatar-wrap {
    width: 180px;
    height: 180px;
    border-radius: 999px;
    padding: 3px;
    background: linear-gradient(
      150deg,
      var(--border-strong),
      var(--border) 60%,
      transparent
    );
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
    margin-bottom: 1.25rem;
  }

  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    object-fit: cover;
    background: var(--bg-elev);
  }

  .name {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.1rem;
  }

  .zh {
    color: var(--fg-muted);
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
  }

  .affiliation {
    font-size: 0.92rem;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
    line-height: 1.55;
  }

  .address {
    font-size: 0.85rem;
    margin-bottom: 1.1rem;
  }

  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 0.4rem;
    justify-content: center;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg-muted);
    transition:
      color var(--t-base),
      border-color var(--t-base),
      background var(--t-base),
      transform var(--t-base);
  }

  .socials a:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: var(--bg-elev);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .profile {
      position: static;
      padding: 0 0 1rem;
    }
    .avatar-wrap {
      width: 140px;
      height: 140px;
    }
  }
</style>
